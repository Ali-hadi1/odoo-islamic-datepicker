<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_hijri_qamari_date.DateTimeField">
        <t t-set="showSeparator" t-value="shouldShowSeparator()" />
        <div class="d-flex flex-column gap-2 align-items-start" t-ref="root">
            <!-- Main DateTime Field Container -->
            <div class="d-flex gap-2 align-items-center w-100">
                <!-- Start date -->
                <t t-if="props.readonly">
                    <div class="d-flex flex-column">
                        <span class="text-truncate" t-esc="getFormattedValue(0)" />
                        <!-- Hijri display for readonly single date/datetime field -->
                        <t t-if="(isDateField or isDateTime) and !relatedField and getHijriFormattedValue(0)">
                            <div class="text-muted" style="font-size:0.85em;font-style:italic;margin-top:2px;" 
                                 t-esc="getHijriFormattedValue(0)" />
                        </t>
                    </div>
                </t>
                <t t-elif="!props.required and !props.alwaysRange and isEmpty(startDateField) and !isEmpty(endDateField)">
                    <button
                        class="o_add_date o_add_start_date btn btn-secondary btn-sm w-100"
                        t-on-click="() => this.addDate(0)"
                    >
                        <i class="fa fa-plus me-2" />
                        Add start date
                    </button>
                </t>
                <t t-elif="props.required or props.alwaysRange or !isEmpty(startDateField) or startDateField === props.name">
                    <div class="d-flex flex-column w-100">
                        <input
                            t-ref="start-date"
                            type="text"
                            t-att-id="showSeparator ? props.endDateField and props.id : props.id"
                            class="o_input cursor-pointer"
                            autocomplete="off"
                            t-att-placeholder="props.placeholder"
                            t-att-data-field="startDateField"
                            t-on-input="onInput"
                        />
                        <!-- Hijri input for start date in range fields (both date and datetime) -->
                        <t t-if="(isDateField or isDateTime) and !props.readonly and relatedField">
                            <div>
                                <HijriDatePicker 
                                    onComponentMounted.bind="setHijriStartPickerComponent"
                                    date="values[0] or false" 
                                    inputId="(props.id or 'datepicker') + '_start_hijri'" 
                                    placeholder="isDateTime ? 'Hijri Date &amp; Time' : 'Hijri Date'"
                                    readonly="false"
                                    fieldIndex="0"
                                    isDateTime="isDateTime"
                                    showSeconds="props.showSeconds"
                                    updateCounter="state.hijriUpdateCounter"
                                    onHijriDateSelected.bind="onHijriDateSelected" />
                            </div>
                        </t>
                    </div>
                    <span
                        t-if="props.warnFuture and isDateInTheFuture(0)"
                        class="fa fa-exclamation-triangle text-danger"
                        title="This date is on the future. Make sure it is what you expected."
                    />
                </t>

                <!-- Separator -->
                <t t-if="showSeparator">
                    <i class="fa fa-long-arrow-right" aria-label="Arrow icon" title="Arrow" />
                </t>

                <!-- End date -->
                <t t-if="endDateField">
                    <t t-if="props.readonly">
                        <div class="d-flex flex-column">
                            <span class="text-truncate" t-esc="getFormattedValue(1)" />
                            <!-- Hijri display for readonly end date/datetime -->
                            <t t-if="(isDateField or isDateTime) and getHijriFormattedValue(1)">
                                <div class="text-muted" style="font-size:0.85em;font-style:italic;margin-top:2px;" 
                                     t-esc="getHijriFormattedValue(1)" />
                            </t>
                        </div>
                    </t>
                    <t t-elif="!props.required and !props.alwaysRange and !isEmpty(startDateField) and isEmpty(endDateField)">
                        <button
                            class="o_add_date o_add_end_date btn btn-secondary btn-sm w-100"
                            t-on-click="() => this.addDate(1)"
                        >
                            <i class="fa fa-plus me-2" />
                            Add end date
                        </button>
                    </t>
                    <t t-elif="props.required or props.alwaysRange or !isEmpty(endDateField) or endDateField === props.name">
                        <div class="d-flex flex-column w-100">
                            <input
                                t-ref="end-date"
                                type="text"
                                t-att-id="props.startDateField and props.id"
                                class="o_input cursor-pointer"
                                autocomplete="off"
                                t-att-placeholder="props.placeholder"
                                t-att-data-field="endDateField"
                                t-on-input="onInput"
                            />
                            <!-- Hijri input for end date (both date and datetime) -->
                            <t t-if="(isDateField or isDateTime) and !props.readonly and endDateField">
                                <div>
                                    <HijriDatePicker 
                                        onComponentMounted.bind="setHijriEndPickerComponent"
                                        date="values[1] or false" 
                                        inputId="(props.id or 'datepicker') + '_end_hijri'" 
                                        placeholder="isDateTime ? 'Hijri Date &amp; Time' : 'Hijri Date'"
                                        readonly="false"
                                        fieldIndex="1"
                                        isDateTime="isDateTime"
                                        showSeconds="props.showSeconds"
                                        updateCounter="state.hijriUpdateCounter"
                                        onHijriDateSelected.bind="onHijriDateSelected" />
                                </div>
                            </t>
                        </div>
                        <span
                            t-if="props.warnFuture and isDateInTheFuture(1)"
                            class="fa fa-exclamation-triangle text-danger"
                            title="This date is on the future. Make sure it is what you expected."
                        />
                    </t>
                </t>
            </div>

            <!-- Hijri input for single date/datetime fields (non-range) -->
            <!-- This shows up BELOW the standard one if we use the flex-column from the top div -->
            <t t-if="(isDateField or isDateTime) and !props.readonly and !relatedField">
                <div class="w-100">
                    <HijriDatePicker 
                        onComponentMounted.bind="setHijriPickerComponent"
                        date="props.value or state.value or false" 
                        inputId="(props.id or 'datepicker') + '_hijri'" 
                        placeholder="isDateTime ? 'Hijri Date &amp; Time' : 'Hijri Date'"
                        readonly="false"
                        fieldIndex="0"
                        isDateTime="isDateTime"
                        showSeconds="props.showSeconds"
                        updateCounter="state.hijriUpdateCounter"
                        onHijriDateSelected.bind="onHijriDateSelected" />
                </div>
            </t>
        </div>
    </t>
</templates>
